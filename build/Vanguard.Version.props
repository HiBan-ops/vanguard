    <VanguardBuildVersionLines Include="{" />
    <VanguardBuildVersionLines Include="    public static class VanguardBuildVersion" />
    <VanguardBuildVersionLines Include="    {" />
    <VanguardBuildVersionLines Include="        public const string Value = &quot;$(VanguardVersion)&quot;%3B" />
    <VanguardBuildVersionLines Include="        public const string AssemblyValue = &quot;$(VanguardVersion).0&quot;%3B" />
    <VanguardBuildVersionLines Include="        public const string BuildLabel = &quot;$(VanguardBuildLabel)&quot;%3B" />
