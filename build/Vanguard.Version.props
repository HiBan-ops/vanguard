  <Target Name="GenerateVanguardBuildVersionSource" BeforeTargets="BeforeCompile">
    <MakeDir Directories="$(VanguardBuildVersionGeneratedDir)" />
    <WriteLinesToFile File="$(VanguardBuildVersionGeneratedFile)" Lines="@(VanguardBuildVersionLines)" Overwrite="true" />
